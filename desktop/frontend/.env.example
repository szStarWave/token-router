# Token Router Desktop — local development environment

# Edition: domestic / international
# international: email login only (WeChat hidden), uses server.flowyaipc.com
VITE_EDITION=domestic

# Optional: use test.flowyaipc.cn during `npm run dev` only
# Also enables browser context menu, DevTools, F12, F5, and Ctrl+R in the desktop shell
# Build / CI ignores this flag and always uses production hosts
# VITE_FLOWY_TEST_SERVER=1
